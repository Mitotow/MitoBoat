# Logging: DEBUG, INFO, WARN or ERROR
LOG_LEVEL=INFO

# Twitch application credentials, from https://dev.twitch.tv/console/apps
TWITCH_ID=
TWITCH_SECRET=

# Login of the Twitch account the bot posts as
IRC_USER=

# Authorization server. REDIRECT_URI must match one of the OAuth Redirect URLs
# registered on the Twitch application exactly, including scheme, port and path.
HTTP_ADDR=127.0.0.1:8080
REDIRECT_URI=http://localhost:8080/auth/callback

# Guards /auth/bot, which mints the token the bot posts as. At least 16
# characters; generate one with: openssl rand -base64 24
ADMIN_SECRET=

# Scopes requested from the bot account and from each streamer. Streamers are
# deliberately not asked for the bot's chat scopes.
BOT_SCOPES=chat:read,chat:edit
STREAMER_SCOPES=moderator:read:followers,channel:read:subscriptions

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PSSWD=
DB_SSLMODE=disable

# Connection pool bounds. These cap the bot's memory use: database/sql would
# otherwise open an unbounded number of connections under load.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# How often the in-memory command cache is rebuilt from the database. Chat is
# served entirely from that cache, so this is the delay before a command edit
# goes live.
COMMAND_CACHE_TTL=5m

# Minimum delay between two uses of the same command in the same channel.
COMMAND_COOLDOWN=3s

# Outbound chat rate limit, per channel. Twitch allows 20 messages per 30s for
# a regular account and 100 for a moderator; going over silences the bot
# account on every channel at once.
SAY_BURST=20
SAY_WINDOW=30s
